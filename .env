# Server Configuration
NODE_ENV=production
PORT=5000

# ====================== PostgreSQL Configuration  ============================
PG_DATABASE=api_monitoring
PG_USER=postgres_user
PG_PASSWORD=postgres_pass
PG_PORT=5432

PG_HOST=postgres #postgres service name

# ====================== PG Admin Configuration  ==============================
PGADMIN_EMAIL=admin@gmail.com
PGADMIN_PASSWORD=admin_pass
PGADMIN_PORT=80

# ====================== MongoDB Configuration  ================================
MONGO_DATABASE=api_monitoring
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass
MONGO_PORT=27017

MONGO_URI=mongodb://mongo_user:mongo_pass@mongo:27017/ # Target 'mongo' service with credentials for containerized Node app

# ====================== Mongo Express Configuration  =========================
MONGO_EXPRESS_USERNAME=mongo_express_user
MONGO_EXPRESS_PASSWORD=mongo_express_pass
MONGO_EXPRESS_PORT=8081


# ====================== RabbitMQ Configuration  =============================
RABBITMQ_USER=rabbitmq_user
RABBITMQ_PASS=rabbitmq_pass
RABBITMQ_VHOST=api_monitoring_vhost

RABBITMQ_URL=amqp://rabbitmq_user:rabbitmq_pass@rabbitmq:5672/api_monitoring_vhost

RABBITMQ_QUEUE=api_hits
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_DELAY=1000