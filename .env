# Server Configuration
NODE_ENV=development
PORT=3000


# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres_user
PG_PASSWORD=postgres_pass

# PG Admin Configuration
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=80

# MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass
MONGO_DATABASE=api_monitoring
MONGO_PORT=27017

# Mongo Express Credentials
MONGO_EXPRESS_USERNAME=mongo_express_user
MONGO_EXPRESS_PASSWORD=mongo_express_pass
MONGO_EXPRESS_PORT=8081

# RabbitMq Configuration
RABBITMQ_DEFAULT_USER=rabbitmq_user
RABBITMQ_DEFAULT_PASS=rabbitmq_pass
RABBITMQ_DEFAULT_VHOST=api_monitoring