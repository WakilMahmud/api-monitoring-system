# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Application environment (development | production | test)
NODE_ENV=development
# Port on which the Node.js API server listens
PORT=3000

# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================
PG_DATABASE=your_pg_database_name
PG_USER=your_pg_username
PG_PASSWORD=your_pg_password
PG_PORT=5432
# Service name used inside Docker network ('postgres'). 
# Use 'localhost' only if running Node app outside Docker.
PG_HOST=postgres

# ==============================================================================
# PGADMIN CONFIGURATION (PostgreSQL Web UI)
# ==============================================================================
PGADMIN_EMAIL=your_pgadmin_email
PGADMIN_PASSWORD=your_pgadmin_password
# Local host port to access pgAdmin dashboard (e.g., http://localhost:80)
PGADMIN_PORT=80

# ==============================================================================
# MONGODB CONFIGURATION
# ==============================================================================
MONGO_DATABASE=your_mongo_database_name
MONGO_INITDB_ROOT_USERNAME=your_mongo_root_username
MONGO_INITDB_ROOT_PASSWORD=your_mongo_root_password
MONGO_PORT=27017

# Connection URI used by Node.js app
# Replace placeholders with your actual username, password, and database name
MONGO_URI=mongodb://your_mongo_root_username:your_mongo_root_password@mongo:27017/your_mongo_database_name?authSource=admin

# ==============================================================================
# MONGO EXPRESS CONFIGURATION (MongoDB Web UI)
# ==============================================================================
MONGO_EXPRESS_USERNAME=your_mongo_express_admin
MONGO_EXPRESS_PASSWORD=your_mongo_express_password
# Local host port to access Mongo Express dashboard (e.g., http://localhost:8081)
MONGO_EXPRESS_PORT=8081

# ==============================================================================
# RABBITMQ CONFIGURATION
# ==============================================================================
# Environment variables for default RabbitMQ container setup
RABBITMQ_DEFAULT_USER=your_rabbitmq_username
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=your_rabbitmq_vhost_name

# AMQP Connection URL targeting the 'rabbitmq' Docker service
RABBITMQ_URL=amqp://your_rabbitmq_username:your_rabbitmq_password@rabbitmq:5672/your_rabbitmq_vhost_name

# Message Queue Configurations
RABBITMQ_QUEUE=api_hits
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_DELAY=1000